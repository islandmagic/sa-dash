USGS_API_KEY=your_usgs_api_key_here
HCDP_API_KEY=your_hcdp_api_key_here
WINLINK_API_KEY=your_winlink_api_key_here

# DreamHost mailbox for county alert ingest + Winlink digest send
MAIL_USER=alerts@example.com
MAIL_PASSWORD=your_mailbox_password
MAIL_IMAP_HOST=imap.dreamhost.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.dreamhost.com
MAIL_SMTP_PORT=465
# Optional: your personal address for Community Notes (FB/Nextdoor forwards)
MAIL_OWNER_FROM=you@example.com
# Optional: comma-separated From substrings (defaults cover GovDelivery/Everbridge/KIUC)
# ALERT_SENDERS=govdelivery.com,everbridge.net,kauai.gov,kauaiwater.org,kiuc.coop

# Winlink digest destination (callsign@winlink.org). Whitelist MAIL_USER in Winlink.
WINLINK_TO=yourcall@winlink.org

# Event mode: auto | on | off (default auto)
EVENT_MODE=auto
# HST hours to push digest while event is active (default 6,18)
DIGEST_SEND_HOURS_HST=6,18
